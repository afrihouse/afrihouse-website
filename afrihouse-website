<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Afrihouse | Hospitality & Digital Services in Tanzania</title>
<meta name="description" content="Afrihouse helps hotels, lodges, apartments, villas and tour operators in Tanzania with websites, online listings and short-term rental management.">
<meta name="theme-color" content="#0B3A40">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --lagoon:#0B3A40; --lagoon-2:#12505A; --mist:#EAF1EF; --paper:#FFFFFF;
  --ink:#14262A; --muted:#4A5F63; --saffron:#E0A62E; --saffron-d:#B8821A; --line:#D3E0DD;
  --serif:'Fraunces',Georgia,'Times New Roman',serif;
  --sans:'Figtree',system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:72px}
body{margin:0;font-family:var(--sans);color:var(--ink);background:var(--paper);line-height:1.6;font-size:1.0625rem;-webkit-text-size-adjust:100%}
img,svg{max-width:100%}
a{color:inherit}
:focus-visible{outline:3px solid var(--saffron);outline-offset:3px}
.wrap{width:min(1080px,100% - 2.5rem);margin-inline:auto}
h1,h2,h3{font-family:var(--serif);font-weight:600;line-height:1.15;margin:0 0 .6em;letter-spacing:-.01em}
h1{font-size:clamp(2.3rem,8vw,4.2rem)}
h2{font-size:clamp(1.8rem,5vw,2.6rem)}
h3{font-size:1.3rem}
p{margin:0 0 1em;max-width:62ch}
section{padding:4.5rem 0}

/* Header */
header{position:sticky;top:0;z-index:50;background:var(--lagoon);color:#fff}
.bar{display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{display:flex;align-items:center;gap:.55rem;text-decoration:none;font-family:var(--serif);font-size:1.5rem;font-weight:600;letter-spacing:.01em}
.logo svg{width:26px;height:26px}
nav ul{list-style:none;margin:0;padding:0;display:flex;gap:1.6rem}
nav a{text-decoration:none;font-weight:500;font-size:.98rem;opacity:.9;padding:.4rem 0}
nav a:hover{opacity:1;text-decoration:underline;text-underline-offset:6px;text-decoration-color:var(--saffron)}
.menu-btn{display:none;background:none;border:1px solid rgba(255,255,255,.4);color:#fff;border-radius:999px;padding:.45rem 1rem;font:inherit;font-weight:500;cursor:pointer}
@media(max-width:820px){
  .menu-btn{display:block}
  nav{position:absolute;left:0;right:0;top:64px;background:var(--lagoon);display:none;border-top:1px solid rgba(255,255,255,.15)}
  nav.open{display:block}
  nav ul{flex-direction:column;gap:0;padding:.5rem 1.25rem 1rem}
  nav a{display:block;padding:.9rem 0;font-size:1.1rem}
}

/* Buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:48px;padding:.75rem 1.5rem;border-radius:999px;font-weight:600;text-decoration:none;border:2px solid transparent;font-size:1rem;cursor:pointer}
.btn-gold{background:var(--saffron);color:var(--ink)}
.btn-gold:hover{background:#ECB84A}
.btn-line{border-color:rgba(255,255,255,.55);color:#fff}
.btn-line:hover{background:rgba(255,255,255,.1)}
.btn-dark{background:var(--lagoon);color:#fff}
.btn-dark:hover{background:var(--lagoon-2)}
.btns{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:1.6rem}

/* Hero */
.hero{background:var(--lagoon);color:#fff;padding:4rem 0 5rem;position:relative;overflow:hidden}
.hero::after{content:"";position:absolute;inset:auto 0 0 0;height:6px;background:linear-gradient(90deg,var(--saffron) 0 33%,var(--lagoon-2) 33% 66%,var(--mist) 66%)}
.hero .lead{font-size:1.2rem;color:#D7E6E3;max-width:52ch}
.hero .tag{color:var(--saffron);font-weight:600;margin-bottom:1rem}
.roof{position:absolute;right:-60px;bottom:-30px;width:min(420px,70vw);opacity:.09;pointer-events:none}

/* Generic blocks */
.alt{background:var(--mist)}
.intro{margin-bottom:2.2rem}
.intro p{color:var(--muted)}
.grid{display:grid;gap:1.1rem;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
.card{background:var(--paper);border:1px solid var(--line);border-left:5px solid var(--saffron);border-radius:10px;padding:1.4rem}
.card p{color:var(--muted);margin:0}
.note{font-size:.95rem;color:var(--muted);margin-top:1.8rem;max-width:70ch}

/* About */
.about{display:grid;gap:2.2rem;grid-template-columns:1.4fr 1fr;align-items:start}
@media(max-width:820px){.about{grid-template-columns:1fr}}
.facts{background:var(--lagoon);color:#fff;border-radius:12px;padding:1.6rem}
.facts dl{margin:0}
.facts dt{font-family:var(--serif);font-size:1.7rem;color:var(--saffron);line-height:1.2}
.facts dd{margin:0 0 1.1rem;color:#D7E6E3;font-size:.98rem}
.facts dd:last-child{margin-bottom:0}
.role{font-weight:600;color:var(--lagoon-2)}

/* Why */
.why{list-style:none;margin:0;padding:0;display:grid;gap:1.4rem;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
.why li{border-top:3px solid var(--lagoon);padding-top:1rem}
.why p{color:var(--muted);margin:0}

/* Portfolio */
.slot{border:2px dashed #8FB0AB;border-radius:12px;padding:1.6rem;background:var(--paper)}
.ph{display:inline-block;background:#FFF1C9;color:#6B4A00;border:1px dashed var(--saffron-d);border-radius:6px;padding:.05rem .45rem;font-size:.9em;font-weight:600}

/* Contact */
.contact{background:var(--lagoon);color:#fff}
.contact p{color:#D7E6E3}
.channels{display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));margin-top:1.6rem}
.chan{border:1px solid rgba(255,255,255,.25);border-radius:12px;padding:1.3rem}
.chan h3{font-size:1.1rem;margin-bottom:.4rem}
.chan p{margin:0 0 1rem}
.chan .ph{background:#FFF1C9}
.social{list-style:none;padding:0;margin:1.8rem 0 0;display:flex;flex-wrap:wrap;gap:.6rem}
.social span{display:inline-block;border:1px dashed rgba(255,255,255,.5);border-radius:999px;padding:.35rem .9rem;font-size:.95rem}

footer{background:#082A2F;color:#B8CBC8;padding:1.8rem 0;font-size:.92rem}
footer .wrap{display:flex;flex-wrap:wrap;gap:.6rem 2rem;justify-content:space-between}

/* Floating WhatsApp */
.wa{position:fixed;right:max(1rem,env(safe-area-inset-right));bottom:max(1rem,env(safe-area-inset-bottom));z-index:60;background:#1FA855;color:#fff;border-radius:999px;min-height:56px;padding:0 1.2rem;display:flex;align-items:center;gap:.55rem;text-decoration:none;font-weight:600;box-shadow:0 6px 18px rgba(0,0,0,.28)}
.wa svg{width:26px;height:26px;fill:#fff}
@media(max-width:420px){.wa span{display:none}.wa{padding:0;width:56px;justify-content:center}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
